# GridironIQ Environment Variables
# Copy this file to .env.local and fill in the values you need.
# Only add credentials for the platforms you want to support.

# ── Yahoo Fantasy OAuth ───────────────────────────────────────────────────────
# Required to connect Yahoo Fantasy leagues.
# 1. Go to https://developer.yahoo.com/apps/
# 2. Click "Create an App"
# 3. Select "Installed Application" (for localhost dev)
# 4. Check "Fantasy Sports" under API Permissions
# 5. Set Redirect URI to: http://localhost:3000/api/yahoo
# 6. Copy the App ID (Client ID) and Client Secret below.

YAHOO_CLIENT_ID=your_yahoo_app_client_id_here
YAHOO_CLIENT_SECRET=your_yahoo_app_client_secret_here
YAHOO_REDIRECT_URI=http://localhost:3000/api/yahoo

# Also expose the Client ID to the browser (public — safe to expose):
NEXT_PUBLIC_YAHOO_CLIENT_ID=your_yahoo_app_client_id_here

# ── ESPN Fantasy ──────────────────────────────────────────────────────────────
# ESPN public leagues need no credentials.
# Private leagues require espn_s2 + SWID cookies — users enter these in the UI.
# No environment variables needed for ESPN.

# ── Sleeper ───────────────────────────────────────────────────────────────────
# Sleeper is fully public — no credentials needed at all.
